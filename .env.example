# Environment Configuration Template for TIA Report Service
# Copy this to .env and customize for your environment

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Development Mode (set to "true" for auto-reload)
# RELOAD=false

# Note: In production, set HOST="0.0.0.0" and use HTTPS

# ── API keys / secrets (NEVER commit real values) ────────────────────────────
# Anthropic key used by /verify-formulas
# ANTHROPIC_API_KEY=
# Gemini key used by the AI summary endpoints
# GEMINI_API_KEY=

# Rate limiting for /verify-formulas (per client IP)
# REPORT_VERIFY_RATE_MAX=20
# REPORT_VERIFY_RATE_WINDOW_S=600

# ── Dataset build / upload scripts ───────────────────────────────────────────
# Firebase Web API key (used by upload_to_firebase.py / scripts/upload_nt_to_firebase.py)
# FIREBASE_API_KEY=
# FIREBASE_STORAGE_BUCKET=crompton-apps.firebasestorage.app
# FIREBASE_UPLOAD_EMAIL=labs@cromptonconcepts.com.au
# Optional: firebase-tools OAuth client secret for non-interactive token refresh
# FIREBASE_CLI_CLIENT_SECRET=
# Where corrected GeoJSON outputs are written (defaults to ./outputs)
# TIA_OUTPUTS_DIR=

# TfNSW Traffic Volume API bearer token (used by enrich_nsw_hv.py)
# TFNSW_API_KEY=
