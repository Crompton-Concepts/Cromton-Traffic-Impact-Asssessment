{
  "name": "cromton-traffic-impact-assessment",
  "version": "1.1.0",
  "private": true,
  "description": "Crompton Traffic Impact Assessment — TypeScript-enhanced frontend",
  "scripts": {
    "test": "node --test calc/tia-calc.test.js",
    "test:watch": "node --test --watch calc/tia-calc.test.js",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --outfile=dist/tia-bundle.js --format=iife --global-name=TIA --sourcemap --target=es2020",
    "build:min": "esbuild src/index.ts --bundle --outfile=dist/tia-bundle.min.js --format=iife --global-name=TIA --minify --sourcemap --target=es2020",
    "watch": "esbuild src/index.ts --bundle --outfile=dist/tia-bundle.js --format=iife --global-name=TIA --sourcemap --target=es2020 --watch",
    "build:prod": "node build-prod.js",
    "build:inline": "node build-prod.js --inline",
    "ci": "npm run typecheck && npm run test && npm run build:prod"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "firebase": "^12.15.0"
  }
}
