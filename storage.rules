rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all dataset files (no auth needed for app users)
    match /datasets/{path=**} {
      allow read: if true;
      // Write restricted to admin users via Firebase Auth custom claim
      // Admin status is synced via Cloud Functions (adminSetUserPassword, reconcileAuthUsers)
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
