{
  "functions": {
    "source": "functions"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "rewrites": [
      {
        "source": "/api/google-address-search",
        "function": "googleAddressSearch"
      },
      {
        "source": "/api/reconcile-auth-users",
        "function": "reconcileAuthUsers"
      }
    ],
    "headers": [
      {
        "source": "**/*.geojson",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
        ]
      },
      {
        "source": "dataset_manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "database.rules.json",
      "storage.rules",
      "deploy.ps1",
      "deploy.bat",
      "deploy.sh",
      "*.bat",
      "*.py",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "NSW/**",
      "stitch_design_system_implementation/**",
      "index_developer.html",
      "calc/*.test.js",
      "requirements.txt",
      "requirements-scripts.txt",
      "package.json",
      "cors.json",
      "tester.py",
      "*.md",
      "*.txt",
      "*.csv",
      "*.xlsx",
      "*.docx",
      "*.kml",
      "*.gz",
      "*.bak",
      "*.png",
      "docs/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "desktop.ini"
    ]
  }
}
