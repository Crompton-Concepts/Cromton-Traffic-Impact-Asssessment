{
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**/*.geojson",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
        ]
      },
      {
        "source": "dataset_manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "deploy.ps1",
      "deploy.sh",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "QLD/**",
      "NSW/**",
      "stitch_design_system_implementation/**",
      "index_developer.html",
      "requirements.txt",
      "cors.json",
      "tester.py",
      "*.md",
      "*.txt",
      "*.csv",
      "*.xlsx",
      "*.docx",
      "*.kml",
      "*.gz",
      "*.bak",
      "*.png",
      "**/__pycache__/**",
      "**/*.pyc",
      "design.md",
      "desktop.ini"
    ]
  }
}
